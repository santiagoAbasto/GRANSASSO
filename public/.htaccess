<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirecciones de URLs legacy hacia la home actual
    RewriteRule ^(?:home-eng/?|home-eng/index(?:\.php|\.html)?|home-es/?|home-es/index(?:\.php|\.html)?|home-pt/?|home-pt/index(?:\.php|\.html)?)$ https://gransasso.com.ar/ [R=301,L,NC]

    # Laravel
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
